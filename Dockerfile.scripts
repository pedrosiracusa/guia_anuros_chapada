FROM python:3.10-slim

# Evita geração de .pyc e buffer de saída
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Instala dependências de sistema (para compilação caso necessário)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Instala bibliotecas Python necessárias para os scripts
RUN pip install --no-cache-dir \
    pandas \
    numpy \
    gspread \
    pydrive \
    beautifulsoup4 \
    lxml \
    python-slugify \
    markdown

# Cria usuário não-root com UID/GID 1000 para compatibilidade de permissões
RUN useradd -m -u 1000 pedro

USER pedro
WORKDIR /app

